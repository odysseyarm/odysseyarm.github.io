{
	// The site is static files only (./dist); no Worker code runs.
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "odysseyarm-site",
	"compatibility_date": "2026-10-01",
	// workers.dev is needed for the per-PR preview URLs (see .github/workflows/site.yml).
	"workers_dev": true,
	"preview_urls": true,
	"assets": {
		"directory": "./dist",
		"html_handling": "auto-trailing-slash",
		"not_found_handling": "404-page"
	}
}
