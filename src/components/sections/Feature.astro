---
import { Image } from 'astro:assets';
import { uploadedImage } from '../../lib/images';

interface Props {
	title: string;
	text: string;
	image: string | null;
	imageAlt: string;
	imageSide: 'left' | 'right';
	dark: boolean;
}
const { title, text, image, imageAlt, imageSide, dark } = Astro.props;
const picture = uploadedImage(image);
---

<section class:list={['section', { dark }]}>
	<div class:list={['container', 'feature', { 'image-left': imageSide === 'left', 'no-image': !picture }]}>
		<div>
			<h2 class="section-title">{title}</h2>
			{text && <p class="lead">{text}</p>}
		</div>
		{
			picture && (
				<Image
					src={picture}
					alt={imageAlt}
					widths={[480, 800, 1200, 1600]}
					sizes="(min-width: 56rem) 36rem, 100vw"
					class="feature-image"
				/>
			)
		}
	</div>
</section>

<style>
	.feature {
		display: grid;
		gap: 2rem;
		align-items: center;
	}
	@media (min-width: 56rem) {
		.feature:not(.no-image) {
			grid-template-columns: 1fr 1.2fr;
		}
		.image-left > :first-child {
			order: 2;
		}
	}
	.feature :global(.feature-image) {
		border-radius: var(--radius);
		width: 100%;
	}
</style>
