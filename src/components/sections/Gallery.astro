---
import { Image } from 'astro:assets';
import { uploadedImage } from '../../lib/images';

interface Props {
	title: string;
	text: string;
	images: readonly { image: string | null; alt: string }[];
}
const { title, text, images } = Astro.props;
const pictures = images.flatMap(({ image, alt }) => {
	const src = uploadedImage(image);
	return src ? [{ src, alt }] : [];
});
---

<section class="section alt">
	<div class="container">
		<h2 class="section-title">{title}</h2>
		{text && <p class="lead">{text}</p>}
		<div class="gallery">
			{
				pictures.map(({ src, alt }) => (
					<Image src={src} alt={alt} widths={[480, 800, 1200]} sizes="(min-width: 48rem) 50vw, 100vw" />
				))
			}
		</div>
	</div>
</section>

<style>
	.gallery {
		display: grid;
		gap: 1.5rem;
		margin-top: 2rem;
		grid-template-columns: repeat(auto-fit, minmax(min(100%, 18rem), 1fr));
	}
	.gallery :global(img) {
		border-radius: var(--radius);
		width: 100%;
	}
</style>
