---
import YouTube from '../YouTube.astro';

interface Props {
	title: string;
	url: string | null;
}
const { title, url } = Astro.props;
---

<section class="section">
	<div class="container narrow">
		{title && <h2 class="section-title">{title}</h2>}
		<YouTube url={url} title={title || 'Video'} />
	</div>
</section>

<style>
	.narrow {
		max-width: 60rem;
		text-align: center;
	}
</style>
