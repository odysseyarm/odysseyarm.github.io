---
interface Props {
	title: string;
	text: string;
	button: { label: string; href: string };
}
const { title, text, button } = Astro.props;
---

<section class="section cta">
	<div class="container">
		<h2 class="section-title">{title}</h2>
		{text && <p class="lead">{text}</p>}
		{button.href && <a class="button" href={button.href}>{button.label || 'Learn more'}</a>}
	</div>
</section>

<style>
	.cta {
		background: var(--brand);
		color: var(--on-brand);
		text-align: center;
	}
	.cta .lead {
		color: inherit;
		opacity: 0.9;
		margin-inline: auto;
	}
	.cta .button {
		margin-top: 1rem;
		background: var(--on-brand);
		color: var(--brand);
		border-color: var(--on-brand);
	}
	.cta .button:hover {
		background: var(--brand-soft);
	}
</style>
