---
// Shows the video thumbnail and only loads YouTube's player when clicked, so
// the page stays fast and sets no YouTube cookies until then.
import { youtubeId } from '../lib/youtube';

interface Props {
	url: string | null | undefined;
	title: string;
}
const { url, title } = Astro.props;
const id = youtubeId(url);
---

{
	id && (
		<lite-youtube class="video" data-id={id} data-title={title}>
			<button type="button" aria-label={`Play video: ${title}`}>
				<img
					src={`https://i.ytimg.com/vi/${id}/hqdefault.jpg`}
					alt=""
					loading="lazy"
					decoding="async"
					width="480"
					height="360"
				/>
				<svg viewBox="0 0 68 48" aria-hidden="true">
					<path d="M66.5 7.7A8.5 8.5 0 0 0 60.5 1.6C55.2.2 34 .2 34 .2s-21.2 0-26.5 1.4A8.5 8.5 0 0 0 1.5 7.7 89 89 0 0 0 0 24a89 89 0 0 0 1.5 16.3 8.5 8.5 0 0 0 6 6c5.3 1.5 26.5 1.5 26.5 1.5s21.2 0 26.5-1.4a8.5 8.5 0 0 0 6-6.1A89 89 0 0 0 68 24a89 89 0 0 0-1.5-16.3z" fill="#f00" />
					<path d="M45 24 27 14v20" fill="#fff" />
				</svg>
			</button>
		</lite-youtube>
	)
}

<script>
	class LiteYouTube extends HTMLElement {
		connectedCallback() {
			this.querySelector('button')?.addEventListener('click', () => {
				const iframe = document.createElement('iframe');
				iframe.src = `https://www.youtube-nocookie.com/embed/${this.dataset.id}?autoplay=1&rel=0&modestbranding=1`;
				iframe.title = this.dataset.title ?? '';
				iframe.allow = 'autoplay; encrypted-media; picture-in-picture; fullscreen';
				iframe.allowFullscreen = true;
				this.replaceChildren(iframe);
			}, { once: true });
		}
	}
	customElements.define('lite-youtube', LiteYouTube);
</script>

<style>
	.video {
		display: block;
		position: relative;
		aspect-ratio: 16 / 9;
		border-radius: var(--radius);
		overflow: hidden;
		background: #000;
	}
	.video button {
		all: unset;
		position: absolute;
		inset: 0;
		cursor: pointer;
	}
	.video button:focus-visible {
		outline: 3px solid var(--link);
		outline-offset: -3px;
	}
	.video img {
		width: 100%;
		height: 100%;
		object-fit: cover;
	}
	.video svg {
		position: absolute;
		inset: 50% auto auto 50%;
		width: 68px;
		translate: -50% -50%;
		opacity: 0.9;
	}
	.video button:hover svg {
		opacity: 1;
	}
	.video :global(iframe) {
		position: absolute;
		inset: 0;
		width: 100%;
		height: 100%;
		border: 0;
	}
</style>
