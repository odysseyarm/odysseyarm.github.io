---
import { Image } from 'astro:assets';
import logo from '../assets/images/logo-white.png';
import { getSettings } from '../lib/site';

const settings = await getSettings();
const path = Astro.url.pathname;
// Highlight the most specific menu item that contains this page.
const current = settings.nav
	.map((item) => item.href)
	.filter((href) => href.startsWith('/') && href !== '/' && path.startsWith(href.replace(/\/$/, '')))
	.sort((a, b) => b.length - a.length)[0];
---

<header class="site-header">
	<div class="container bar">
		<a href="/" class="brand">
			<Image src={logo} alt="Odyssey Arm" height={30} densities={[1, 2]} />
		</a>
		<button class="menu-toggle" type="button" aria-label="Menu" aria-expanded="false" aria-controls="site-nav">
			<span></span><span></span>
		</button>
		<nav id="site-nav" aria-label="Main">
			{
				settings.nav.map((item) => (
					<a href={item.href} aria-current={item.href === current ? 'page' : undefined}>
						{item.label}
					</a>
				))
			}
			{settings.storeUrl && <a class="button store" href={settings.storeUrl}>Store</a>}
		</nav>
	</div>
</header>

<script>
	const toggle = document.querySelector<HTMLButtonElement>('.menu-toggle');
	toggle?.addEventListener('click', () => {
		const open = toggle.getAttribute('aria-expanded') !== 'true';
		toggle.setAttribute('aria-expanded', String(open));
	});
</script>

<style>
	/* Translucent bar that blurs the page scrolling under it. */
	.site-header {
		position: sticky;
		top: 0;
		z-index: 10;
		background: rgb(39 37 37 / 0.72);
		backdrop-filter: saturate(180%) blur(20px);
		-webkit-backdrop-filter: saturate(180%) blur(20px);
		border-bottom: 1px solid rgb(255 255 255 / 0.08);
	}
	.bar {
		display: flex;
		align-items: center;
		justify-content: space-between;
		min-height: 3.5rem;
	}
	.brand :global(img) {
		height: 30px;
		width: auto;
	}
	nav {
		display: flex;
		align-items: center;
		gap: 1.75rem;
		font-size: 0.9rem;
	}
	nav a:not(.button) {
		color: var(--text);
		text-decoration: none;
		opacity: 0.85;
		transition: opacity 0.2s;
	}
	nav a[aria-current='page'],
	nav a:not(.button):hover {
		opacity: 1;
		color: var(--text-strong);
	}
	.store {
		padding: 0.45em 1em;
		font-size: 0.85rem;
	}
	.menu-toggle {
		display: none;
		background: none;
		border: 0;
		cursor: pointer;
		padding: 0.75rem 0.25rem;
	}
	.menu-toggle span {
		display: block;
		width: 1.25rem;
		height: 1.5px;
		margin: 5px 0;
		background: var(--text-strong);
		transition: transform 0.3s var(--ease-out);
	}
	@media (max-width: 47.99rem) {
		.menu-toggle {
			display: block;
		}
		.menu-toggle[aria-expanded='true'] span:first-child {
			transform: translateY(3.25px) rotate(45deg);
		}
		.menu-toggle[aria-expanded='true'] span:last-child {
			transform: translateY(-3.25px) rotate(-45deg);
		}
		nav {
			display: none;
			position: absolute;
			inset: 100% 0 auto 0;
			height: calc(100dvh - 100%);
			flex-direction: column;
			align-items: stretch;
			gap: 0;
			padding: 1rem var(--gutter);
			background: var(--bg);
			font-size: 1.5rem;
			font-weight: 600;
		}
		.menu-toggle[aria-expanded='true'] + nav {
			display: flex;
		}
		nav a:not(.button) {
			padding: 0.6rem 0;
			border-bottom: 1px solid var(--border);
		}
		.store {
			margin-top: 1.5rem;
			font-size: 1rem;
			padding: 0.8em;
		}
	}
</style>
