---
import Heading from './Heading.astro';
import Icon from './Icon.astro';
import Paragraphs from './Paragraphs.astro';
import type { HighlightItem, TwoTone } from './types';

interface Props {
	heading: TwoTone;
	intro: string;
	cards: readonly { icon: string; title: string; paragraphs: readonly HighlightItem[] }[];
}
const { heading, intro, cards } = Astro.props;
---

<section class="section">
	<div class="container">
		<Heading heading={heading} class="title" />
		{intro && <div class="lead"><Paragraphs text={intro} /></div>}
		<div class="cards">
			{
				cards.map((card) => (
					<article data-reveal>
						<span class="icon">
							<Icon name={card.icon} />
						</span>
						<h3>{card.title}</h3>
						{card.paragraphs.map((p) => (
							<p class:list={{ accent: p.highlight }}>{p.text}</p>
						))}
					</article>
				))
			}
		</div>
	</div>
</section>

<style>
	.cards {
		display: grid;
		gap: 1.25rem;
		margin-top: 2.5rem;
		grid-template-columns: repeat(auto-fit, minmax(min(100%, 17rem), 1fr));
	}
	article {
		padding: 1.75rem;
		border-radius: var(--radius-lg);
		background: var(--bg-raised);
		border: 1px solid var(--border);
		transition:
			border-color 0.3s,
			transform 0.6s var(--ease-out);
	}
	article:hover {
		border-color: var(--accent);
	}
	.icon {
		display: inline-grid;
		place-items: center;
		width: 3.25rem;
		height: 3.25rem;
		border-radius: 14px;
		background: var(--accent);
		color: var(--on-accent);
		margin-bottom: 1.25rem;
	}
	h3 {
		font-size: 1.35rem;
		margin-bottom: 0.75rem;
	}
</style>
