---
import Heading from './Heading.astro';
import Paragraphs from './Paragraphs.astro';
import type { Link, TwoTone } from './types';

interface Props {
	heading: TwoTone;
	text: string;
	button: Link;
}
const { heading, text, button } = Astro.props;
---

<section class="section">
	<div class="container">
		<div class="panel">
			<Heading heading={heading} class="title" />
			<div class="lead"><Paragraphs text={text} /></div>
			{button.href && <a class="button" href={button.href} data-reveal>{button.label || 'Learn more'}</a>}
		</div>
	</div>
</section>

<style>
	.panel {
		padding: clamp(2rem, 6vw, 4.5rem);
		border-radius: var(--radius-lg);
		background: radial-gradient(120% 140% at 0% 0%, #3d2a1a, var(--bg-raised) 60%);
		text-align: center;
	}
	.lead {
		margin-inline: auto;
	}
	.button {
		margin-top: 2rem;
	}
</style>
