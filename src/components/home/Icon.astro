---
// Line icons for "Cards with icons". Add one here and to the icon list in
// keystatic.config.ts to make it available to editors.
interface Props {
	name: string;
}
const paths: Record<string, string> = {
	instructor:
		'M3 4h18v11H3z M8 20l2-5 M16 20l-2-5 M7 8h6 M7 11h4 M17 7.5a1.5 1.5 0 1 1-3 0 1.5 1.5 0 0 1 3 0z',
	store: 'M4 9h16l-1.5-5h-13z M4 9v11h16V9 M9 20v-6h6v6 M4 9a2.7 2.7 0 0 0 5.3 0 2.7 2.7 0 0 0 5.4 0 2.7 2.7 0 0 0 5.3 0',
	handshake:
		'M2 12l4-4 4 1 3-2 4 1 5 4 M2 12l5 5 2-1 2 2 2-1 2 2 4-4 3-3 M9 9l-2 3 2 1 3-2 3 3',
	target: 'M12 3v4 M12 17v4 M3 12h4 M17 12h4 M12 19a7 7 0 1 0 0-14 7 7 0 0 0 0 14z M12 13a1 1 0 1 0 0-2 1 1 0 0 0 0 2z',
	code: 'M8 7l-5 5 5 5 M16 7l5 5-5 5 M14 4l-4 16',
};
const d = paths[Astro.props.name] ?? paths.target;
---

<svg
	viewBox="0 0 24 24"
	width="28"
	height="28"
	fill="none"
	stroke="currentColor"
	stroke-width="1.6"
	stroke-linecap="round"
	stroke-linejoin="round"
	aria-hidden="true"><path d={d}></path></svg
>
