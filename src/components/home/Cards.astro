---
import { Image } from 'astro:assets';
import Heading from './Heading.astro';
import Paragraphs from './Paragraphs.astro';
import { uploadedImage } from '../../lib/images';
import type { TwoTone } from './types';

interface Props {
	heading: TwoTone;
	subheading: TwoTone;
	cards: readonly { image: string | null; imageAlt: string; title: string; text: string; highlight: boolean }[];
}
const { heading, subheading, cards } = Astro.props;
---

<section class="section">
	<div class="container">
		<Heading heading={heading} class="title" />
		<Heading heading={subheading} as="h3" class="sub" />
		<div class="cards">
			{
				cards.map((card) => {
					const picture = uploadedImage(card.image);
					return (
						<article data-reveal>
							{picture && (
								<div class="frame">
									<Image
										src={picture}
										alt={card.imageAlt}
										widths={[400, 700, 1000]}
										sizes="(min-width: 60rem) 22rem, (min-width: 40rem) 45vw, 100vw"
									/>
								</div>
							)}
							<h3 class:list={{ accent: card.highlight }}>{card.title}</h3>
							<Paragraphs text={card.text} class="muted" reveal={false} />
						</article>
					);
				})
			}
		</div>
	</div>
</section>

<style>
	.title {
		margin-bottom: 0.4em;
	}
	.sub {
		font-size: clamp(1.15rem, 2vw, 1.4rem);
		letter-spacing: -0.015em;
		line-height: 1.35;
		margin-bottom: 2.5rem;
	}
	.cards {
		display: grid;
		gap: 1.5rem;
		grid-template-columns: repeat(auto-fit, minmax(min(100%, 17rem), 1fr));
	}
	.frame {
		aspect-ratio: 1;
		overflow: hidden;
		border-radius: var(--radius-lg);
		background: var(--bg-raised);
		margin-bottom: 1.25rem;
	}
	.frame :global(img) {
		width: 100%;
		height: 100%;
		object-fit: cover;
		transition: transform 1.2s var(--ease-out);
	}
	article:hover .frame :global(img) {
		transform: scale(1.03);
	}
	article h3 {
		font-size: 1.35rem;
		margin-bottom: 0.5rem;
	}
</style>
