---
import { Image } from 'astro:assets';
import logo from '../assets/images/logo-white.png';
import { getSettings } from '../lib/site';

const settings = await getSettings();
const year = new Date().getFullYear();
---

<footer class="site-footer">
	<div class="container cols">
		<div>
			<Image src={logo} alt="Odyssey Arm" height={36} densities={[1, 2]} class="logo" />
			<p>© {year} {settings.copyright}</p>
			{settings.email && <p><a href={`mailto:${settings.email}`}>{settings.email}</a></p>}
			{settings.phone && <p>{settings.phone}</p>}
		</div>
		<nav aria-label="Footer">
			{settings.nav.map((item) => <a href={item.href}>{item.label}</a>)}
			<a href="https://github.com/odysseyarm">GitHub</a>
		</nav>
	</div>
</footer>

<style>
	.site-footer {
		border-top: 1px solid var(--border);
		background: var(--bg-deep);
		padding-block: 3.5rem;
		font-size: 0.95rem;
		color: var(--text-muted);
	}
	.cols {
		display: flex;
		flex-wrap: wrap;
		justify-content: space-between;
		gap: 2rem;
	}
	p {
		margin: 0 0 0.35rem;
	}
	.cols :global(.logo) {
		height: 36px;
		width: auto;
		margin-bottom: 1.25rem;
	}
	nav {
		display: flex;
		flex-wrap: wrap;
		gap: 0.5rem 1.5rem;
		align-content: flex-start;
	}
	a {
		color: inherit;
	}
</style>
