---
// Starlight's sidebar under a title naming this set of docs ("Using Odyssey" or
// "Developers"). Keep API links outside generated content so sync-docs cannot
// overwrite this discovery path.
import Default from '@astrojs/starlight/components/Sidebar.astro';

const topic = Astro.locals.starlightSidebarTopics?.topics.find((t) => t.isCurrent);
const isDeveloper = topic?.link === '/developers/';

---

{
	topic && (
		<a class="sidebar-topic" href={topic.link}>
			{topic.label}
		</a>
	)
}
{isDeveloper && (
	<nav class="api-links" aria-label="Rust API references">
		<a href="/api/latest/">Rust API (latest release)</a>
		<a href="/api/master/">Rust API (master)</a>
	</nav>
)}
<Default><slot /></Default>

<style>
	.sidebar-topic {
		display: block;
		margin-bottom: 0.75rem;
		padding-bottom: 0.75rem;
		border-bottom: 1px solid var(--sl-color-hairline);
		color: var(--sl-color-white);
		font-size: var(--sl-text-xs);
		font-weight: 600;
		letter-spacing: 0.06em;
		text-transform: uppercase;
		text-decoration: none;
	}
	.api-links {
		display: grid;
		gap: 0.5rem;
		margin-block: 0.75rem;
	}
	.api-links a {
		font-size: var(--sl-text-sm);
	}
	.sidebar-topic:hover {
		color: var(--sl-color-accent-high);
	}
</style>
