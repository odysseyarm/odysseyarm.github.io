---
import Base from '../layouts/Base.astro';
import YouTube from '../components/YouTube.astro';
import CallToAction from '../components/sections/CallToAction.astro';
import Feature from '../components/sections/Feature.astro';
import Gallery from '../components/sections/Gallery.astro';
import LatestPosts from '../components/sections/LatestPosts.astro';
import Video from '../components/sections/Video.astro';
import { getHome } from '../lib/site';

// Everything on this page is edited in Keystatic under "Front page".
const { hero, sections } = await getHome();
const heroVideo = hero.videos.find(Boolean);
---

<Base>
	<section class="section hero">
		<div class:list={['container', 'hero-grid', { 'no-video': !heroVideo }]}>
			<div>
				<h1>{hero.title}</h1>
				{hero.subtitle && <p class="lead">{hero.subtitle}</p>}
				<div class="actions">
					{hero.primary.href && <a class="button" href={hero.primary.href}>{hero.primary.label}</a>}
					{
						hero.secondary.href && (
							<a class="button secondary" href={hero.secondary.href}>
								{hero.secondary.label}
							</a>
						)
					}
				</div>
			</div>
			{heroVideo && <YouTube url={heroVideo} title={hero.title} />}
		</div>
	</section>

	{
		sections.map((section) => {
			switch (section.discriminant) {
				case 'feature':
					return <Feature {...section.value} />;
				case 'gallery':
					return <Gallery {...section.value} />;
				case 'video':
					return <Video {...section.value} />;
				case 'callToAction':
					return <CallToAction {...section.value} />;
				case 'latestPosts':
					return <LatestPosts {...section.value} />;
			}
		})
	}
</Base>

<style>
	.hero {
		background: linear-gradient(180deg, var(--brand-soft), var(--bg));
	}
	.hero-grid {
		display: grid;
		gap: 2.5rem;
		align-items: center;
	}
	@media (min-width: 56rem) {
		.hero-grid:not(.no-video) {
			grid-template-columns: 1fr 1.25fr;
		}
	}
	h1 {
		font-size: clamp(2.25rem, 6vw, 3.75rem);
		margin: 0 0 0.4em;
	}
	.actions {
		display: flex;
		flex-wrap: wrap;
		gap: 0.75rem;
		margin-top: 1.5rem;
	}
</style>
