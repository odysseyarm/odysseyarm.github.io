---
import Base from '../layouts/Base.astro';
import { formatDate } from '../lib/blog';
import { desktopReleases, formatSize, type Download } from '../lib/releases';
import { getDownloadsPage } from '../lib/site';

// The text is edited in Keystatic under "Downloads page". The files come from
// Odyssey Desktop releases on GitHub when the site is built.
const page = await getDownloadsPage();
const [release, ...past] = await desktopReleases();

// Fixed by the app (crates/odyssey-desktop/OFFLINE.md in odysseyarm/odyssey), so not editable copy.
const offline: { os: Download['platform']; turnOn: string; policy: string; pack: string }[] = [
	{
		os: 'Windows',
		turnOn: 'msiexec /i Odyssey-<version>-win-x64-full.msi OFFLINE_MODE=1',
		policy: '%ProgramData%\\OdysseyArm\\Odyssey\\policy.json',
		pack: '%ProgramData%\\OdysseyArm\\Odyssey\\firmware-pack',
	},
	{
		os: 'Linux',
		turnOn: '{ "offline": true } in the policy file',
		policy: '/etc/odyssey/policy.json',
		pack: '/var/lib/odyssey/firmware-pack',
	},
];
---

<Base title={page.title} description={page.intro}>
	<section class="section">
		<div class="container">
			<h1 class="title">{page.title}</h1>
			{page.intro && <p class="lead">{page.intro}</p>}

			{
				release ? (
					<div class="release">
						<h2>
							Odyssey Desktop {release.version}
						</h2>
						<p class="muted">
							Released {formatDate(release.date)} · <a href={release.url}>Release notes</a>
						</p>
						<ul class="files">
							{release.downloads.map((d) => (
								<li>
									<a class="button" href={d.url}>
										{d.label}
									</a>
									<span class="muted">
										{d.file} · {formatSize(d.size)}
									</span>
								</li>
							))}
						</ul>
					</div>
				) : (
					<p>
						No release is available right now. See{' '}
						<a href="https://github.com/odysseyarm/odyssey/releases">all releases on GitHub</a>.
					</p>
				)
			}

			{
				page.notes.map((note) => (
					<div class="note">
						<h2>{note.title}</h2>
						<p>{note.text}</p>
					</div>
				))
			}

			<div class="note">
				<h2>Offline mode at a glance</h2>
				<table>
					<thead>
						<tr>
							<th>System</th>
							<th>Turn offline mode on</th>
							<th>Policy file</th>
							<th>Firmware pack folder</th>
						</tr>
					</thead>
					<tbody>
						{offline.map((o) => (
							<tr>
								<td>{o.os}</td>
								<td><code>{o.turnOn}</code></td>
								<td><code>{o.policy}</code></td>
								<td><code>{o.pack}</code></td>
							</tr>
						))}
					</tbody>
				</table>
				<p class="muted">
					On any system, <code>ODYSSEY_OFFLINE=1</code> also turns offline mode on, and{' '}
					<code>ODYSSEY_FIRMWARE_PACK_DIR</code> or <code>firmware_pack_dir</code> in the policy file
					points at a different folder. Changes apply the next time Odyssey starts.
				</p>
			</div>

			{
				past.length > 0 && (
					<div class="note">
						<h2>Previous versions</h2>
						<ul class="past">
							{past.map((r) => (
								<li>
									<strong>{r.version}</strong>{' '}
									<span class="muted">
										{formatDate(r.date)} · <a href={r.url}>Release notes</a>
									</span>
									<br />
									{r.downloads.map((d, i) => (
										<>
											{i > 0 && ' · '}
											<a href={d.url}>{d.label}</a>
										</>
									))}
								</li>
							))}
						</ul>
					</div>
				)
			}

			<div class="note">
				<h2>Building software for Odyssey?</h2>
				<p>
					The client SDK and how to install it in each language are covered in the{' '}
					<a href="/developers/">developer docs</a>.
				</p>
			</div>
		</div>
	</section>
</Base>

<style>
	.release {
		margin-top: 2rem;
		padding: 1.5rem;
		border: 1px solid var(--border);
		border-radius: var(--radius);
		background: var(--bg-raised);
	}
	.release h2 {
		margin: 0;
	}
	.files {
		list-style: none;
		padding: 0;
		margin: 1.5rem 0 0;
		display: grid;
		gap: 1rem;
	}
	.files li {
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		gap: 0.5rem 1rem;
	}
	.files .muted {
		overflow-wrap: anywhere;
	}
	.note {
		max-width: 44rem;
		margin-top: 2.5rem;
	}
	.note h2 {
		font-size: 1.25rem;
		margin-bottom: 0.25rem;
	}
	table {
		width: 100%;
		border-collapse: collapse;
		margin: 0.75rem 0;
	}
	th,
	td {
		text-align: left;
		vertical-align: top;
		padding: 0.5rem;
		border-bottom: 1px solid var(--border);
	}
	td code {
		overflow-wrap: anywhere;
	}
	.past {
		list-style: none;
		padding: 0;
		display: grid;
		gap: 0.75rem;
	}
</style>
